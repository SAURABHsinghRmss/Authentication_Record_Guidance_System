  "knowledge_base": [
    {
      "id": "kb_01",
      "topic": "Credit Transfer Policy",
      "content": "Students can transfer up to 20% of total degree credits (32 credits for a 160-credit program) via SWAYAM, NPTEL, or recognized partner institutions under the Academic Bank of Credits (ABC) framework. Minimum grade required is 'B' or equivalent (CGPA 6.0+)."
    },
    {
      "id": "kb_02",
      "topic": "Attendance Requirements",
      "content": "A minimum of 75% attendance is mandatory in all theory and practical courses to appear for end-semester examinations. Medical condonation up to 10% is permitted with valid hospital admission records and approval from the Dean of Academics."
    },
    {
      "id": "kb_03",
      "topic": "APAAR & DigiLocker Integration",
      "content": "APAAR (Automated Permanent Academic Account Registry) ID acts as a lifelong digital identifier (EduLocker ID) linked with National Academic Depository (NAD). All degree certificates, mark sheets, and transfer certificates must be verified via DigiLocker API integration."
    },
    {
      "id": "kb_04",
      "topic": "Backlog & Re-evaluation Rules",
      "content": "Students with more than 3 active backlogs are not eligible for campus placement drives until cleared. Re-evaluation applications must be submitted within 14 days of grade publication."
    },
    {
      "id": "kb_05",
      "topic": "Biometric Gatekeeper Security",
      "content": "Multimodal biometric verification combines facial recognition (DeepFace VGG-Face), ID document OCR (EasyOCR), and voice verification (SpeechBrain) with a weighted fusion score threshold of 85% to grant access."
    }
  ]
